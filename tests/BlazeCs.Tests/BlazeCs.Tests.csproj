<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Not artifacts/bin: that is the shipped daemon's directory, which must not carry a Roslyn of its own. -->
    <OutDir>$(MSBuildThisFileDirectory)../../artifacts/tests/</OutDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- The daemon excludes Roslyn's runtime assets and loads the SDK's; the tests run on the exact
         version it is compiled against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <ProjectReference Include="../../src/BlazeCs/BlazeCs.csproj" />
    <!-- Test frameworks' packages, in artifacts/kits, for the hot reload tests. -->
    <ProjectReference Include="../TestHostKits/XunitV3Kit/XunitV3Kit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TestHostKits/NUnitKit/NUnitKit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TestHostKits/MSTestKit/MSTestKit.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
