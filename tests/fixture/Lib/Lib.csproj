<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-targeted, so each target framework is its own unit; only net10.0 needs to run. The empty
         TargetFramework undoes Directory.Build.props', which would otherwise make this a single target. -->
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Read by Salutation.Greeting. -->
  <ItemGroup>
    <EmbeddedResource Include="greeting.txt" />
  </ItemGroup>

  <!-- Lists Greeter.cs a second time, as a target that adds a generated file again would: csc compiles it
       once (warning CS2002), and so must blaze-cs. -->
  <Target Name="AddGreeterAgain" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="Greeter.cs" />
    </ItemGroup>
  </Target>

  <!-- A source only a target hooked to BeforeBuild lists, as a code generator's target would: the in-process
       pass must run BeforeBuild to see it. Outside the project directory, so no glob lists it. -->
  <Target Name="AddHookedSource" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Compile Include="../Hooked/Hooked.cs" />
    </ItemGroup>
  </Target>
</Project>
