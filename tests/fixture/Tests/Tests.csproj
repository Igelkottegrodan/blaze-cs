<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Consumer/Consumer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The runtime the tests must report: the major version of this project's own target framework. -->
    <AssemblyMetadata Include="TargetRuntimeMajor" Value="$([System.Version]::Parse($(TargetFrameworkVersion.Substring(1))).Major)" />
  </ItemGroup>
</Project>
