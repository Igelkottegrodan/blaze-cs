<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>blaze-cs-testhost</AssemblyName>
    <RootNamespace>BlazeCs.TestHost</RootNamespace>
    <!-- A test project may target a newer runtime than this host does (net11.0 on a net10.0 host
         cannot load), so run on the newest one installed. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test projects often need ASP.NET Core; the shared framework must be in the host's
         default load context because collectible contexts cannot load it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
