<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>blaze-cs-testhost</AssemblyName>
    <RootNamespace>BlazeCs.TestHost</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <!-- The daemon starts the host on the runtime the test project targets (a runtimeconfig.json
         per major), so there is no roll-forward past this one. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Test projects often need ASP.NET Core; the shared framework must be in the host's
         default load context because collectible contexts cannot load it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
