<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>blaze-cs</AssemblyName>
    <RootNamespace>BlazeCs</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>blaze-cs</ToolCommandName>
    <PackageId>blaze-cs</PackageId>
    <Version>0.1.0</Version>
    <Description>Faster rebuilds for C# solutions: a warm daemon that recompiles only what an edit needs.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The test host runs from the CLI's directory, so the tool package carries it too. -->
    <ProjectReference Include="..\BlazeCs.TestHost\BlazeCs.TestHost.csproj" />
    <!-- What the daemon and the test host say to each other. -->
    <Compile Include="..\BlazeCs.TestHost\Protocol.cs" Link="TestHostProtocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compiled against RoslynVersion (Directory.Build.props); at run time the daemon loads the Roslyn
         that ships with the solution's SDK (see SdkRoslyn), so its output matches csc byte for byte. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" ExcludeAssets="runtime" />
    <InternalsVisibleTo Include="BlazeCs.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MSBuild logger the daemon's `dotnet build` runs with, next to the CLI and in the tool package,
         and the record it writes. -->
    <Compile Include="..\BlazeCs.Logger\BuildRecord.cs" Link="BuildRecord.cs" />
    <ProjectReference Include="..\BlazeCs.Logger\BlazeCs.Logger.csproj" ReferenceOutputAssembly="false"
                      OutputItemType="None" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
